{
  "name": "Fintraffic Theme",
  "version": "0.1",
  "description": "Fintraffic theme configuration for Abzu Stop Place Registry",
  "author": "",
  "environment": {
    "development": {
      "color": "#457645",
      "showBadge": true,
      "label": "DEV"
    },
    "test": {
      "color": "#ffe082",
      "showBadge": true,
      "label": "TEST"
    },
    "prod": {
      "color": "#181c56",
      "showBadge": false,
      "label": "PROD"
    }
  },
  "assets": {
    "logo": "/fintraffic-logo.png",
    "logoHeight": {
      "xs": 20,
      "sm": 24,
      "md": 24
    },
    "favicon": "/favicon.ico"
  },
  "fonts": {
    "faces": [
      {
        "family": "Public Sans",
        "src": "fonts/public-sans-variable.woff2",
        "format": "woff2",
        "weight": "100 900",
        "style": "normal",
        "display": "swap"
      },
      {
        "family": "Roboto Mono",
        "src": "fonts/roboto-mono-latin.woff2",
        "format": "woff2",
        "weight": "100 700",
        "style": "normal",
        "display": "swap",
        "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
      },
      {
        "family": "Roboto Mono",
        "src": "fonts/roboto-mono-latin-ext.woff2",
        "format": "woff2",
        "weight": "100 700",
        "style": "normal",
        "display": "swap",
        "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
      }
    ]
  },
  "palette": {
    "multimodal": {
      "main": "#7a4dd6",
      "contrastText": "#ffffff"
    },
    "mode": "light",
    "primary": {
      "main": "#1777F8",
      "dark": "#0034AC",
      "light": "#90CEFE",
      "contrastText": "#FFFFFF"
    },
    "secondary": {
      "main": "#505064",
      "dark": "#2C2C44",
      "light": "#9696AA",
      "contrastText": "#FFFFFF"
    },
    "background": {
      "default": "#FFFFFF",
      "paper": "#FFFFFF",
      "tint": "#F6F6F6"
    },
    "text": {
      "primary": "#000000",
      "secondary": "#505064",
      "disabled": "#9696AA"
    },
    "divider": "#E3E3E3",
    "info": {
      "main": "#1777F8",
      "dark": "#0034AC",
      "light": "#90CEFE",
      "contrastText": "#FFFFFF"
    },
    "success": {
      "main": "#25A794",
      "dark": "#005F61",
      "light": "#82E8C3",
      "contrastText": "#000000"
    },
    "warning": {
      "main": "#EEC200",
      "dark": "#B47324",
      "light": "#FFE37F",
      "contrastText": "#000000"
    },
    "error": {
      "main": "#E55636",
      "dark": "#B40000",
      "light": "#FF9B87",
      "contrastText": "#FFFFFF"
    },
    "action": {
      "hover": "rgba(0, 0, 0, 0.04)",
      "selected": "rgba(0, 0, 0, 0.08)",
      "focus": "rgba(0, 0, 0, 0.12)",
      "active": "rgba(0, 0, 0, 0.56)",
      "disabled": "rgba(0, 0, 0, 0.38)",
      "disabledBackground": "rgba(0, 0, 0, 0.12)"
    }
  },
  "typography": {
    "fontFamily": "\"Public Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", Arial, sans-serif",
    "h1": {
      "fontSize": "3rem",
      "fontWeight": 700,
      "letterSpacing": "-0.5px"
    },
    "h2": {
      "fontSize": "2.25rem",
      "fontWeight": 700
    },
    "h3": {
      "fontSize": "1.75rem",
      "fontWeight": 700
    },
    "subtitle1": {
      "fontSize": "1rem",
      "fontWeight": 600
    },
    "body1": {
      "fontSize": "1rem"
    },
    "body2": {
      "fontSize": "0.875rem"
    },
    "button": {
      "textTransform": "none",
      "fontWeight": 600
    },
    "monospace": "\"Roboto Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "shape": {
    "borderRadius": 4
  },
  "components": {
    "MuiCssBaseline": {
      "styleOverrides": {
        "body": {
          "backgroundColor": "#FFFFFF",
          "color": "#000000",
          "fontFeatureSettings": "\"liga\" 1, \"kern\" 1"
        }
      }
    },
    "MuiButton": {
      "defaultProps": {
        "disableElevation": true
      },
      "styleOverrides": {
        "root": {
          "textTransform": "none",
          "borderRadius": 4,
          "fontWeight": 600
        }
      },
      "variants": [
        {
          "props": {
            "variant": "contained",
            "color": "primary"
          },
          "style": {
            "backgroundColor": "#1777F8",
            "color": "#FFFFFF"
          }
        },
        {
          "props": {
            "variant": "outlined",
            "color": "primary"
          },
          "style": {
            "borderColor": "#1777F8",
            "color": "#1777F8"
          }
        }
      ]
    },
    "MuiLink": {
      "styleOverrides": {
        "root": {
          "color": "#1777F8",
          "fontWeight": 600
        }
      }
    },
    "MuiChip": {
      "styleOverrides": {
        "filled": {
          "backgroundColor": "#F7F7F7"
        },
        "outlined": {
          "borderColor": "#E5E5E5"
        }
      },
      "variants": [
        {
          "props": {
            "variant": "filled",
            "color": "primary"
          },
          "style": {
            "backgroundColor": "#1777F8",
            "color": "#FFFFFF"
          }
        }
      ]
    },
    "MuiAppBar": {
      "styleOverrides": {
        "colorPrimary": {
          "backgroundColor": "#000000",
          "color": "#FFFFFF"
        }
      }
    },
    "MuiPaper": {
      "styleOverrides": {
        "root": {
          "backgroundImage": "none"
        }
      }
    },
    "MuiDialog": {
      "styleOverrides": {
        "paper": {
          "boxShadow": "0px 300px 300px rgba(0, 0, 0, 0.2)"
        }
      }
    },
    "MuiAlert": {
      "variants": [
        {
          "props": {
            "variant": "standard",
            "severity": "success"
          },
          "style": {
            "backgroundColor": "#EAFFF8",
            "color": "#004042"
          }
        },
        {
          "props": {
            "variant": "standard",
            "severity": "warning"
          },
          "style": {
            "backgroundColor": "#FFFADB",
            "color": "#6C3E05"
          }
        },
        {
          "props": {
            "variant": "standard",
            "severity": "error"
          },
          "style": {
            "backgroundColor": "#FFF0ED",
            "color": "#720000"
          }
        },
        {
          "props": {
            "variant": "standard",
            "severity": "info"
          },
          "style": {
            "backgroundColor": "#EFF8FF",
            "color": "#001C5B"
          }
        }
      ]
    }
  }
}
